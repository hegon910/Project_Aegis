      fadeDuration: 0
    enableDialogueEffect: 1
    dialogueData:
      dialogue: "\u201C\uC804\uC120\uC758 \uC9C0\uD718\uAD00\uC744 \uCC28\uCD9C\uD558\uAE30
        \uC704\uD574 \uAD6D\uC655 \uD3D0\uD558\uAED8\uC11C \uC9C1\uC811 \uBA74\uC811\uC744
        \uC8FC\uAD00\uD558\uC2E0\uB2E4\uACE0 \uD569\uB2C8\uB2E4.\u201D"
