    enableDialogueEffect: 1
    dialogueData:
      dialogue: "\u201C\uC804\uD22C \uACBD\uD5D8\uB3C4 \uC804\uBB34\uD558\uACE0..\n\uC804\uC220\uC774\uB098
        \uC804\uD22C\uC5D0 \uAD00\uD574\uC11C\uB294 \uB0B4\uAC00 \uADF8\uB9AC \uC7AC\uB2A5\uC774
