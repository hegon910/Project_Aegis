    enableDialogueEffect: 1
    dialogueData:
      dialogue: "\u201C\uC544\uB2D9\uB2C8\uB2E4. \uC800\uB294 \uC9C0\uD718\uAD00\uB2D8\uC774
        \uADF8 \uC790\uB9AC\uAC00 \uBC14\uB85C \uC9C0\uD718\uAD00\uB2D8\uC758 \uC790\uB9AC\uB77C\uACE0
