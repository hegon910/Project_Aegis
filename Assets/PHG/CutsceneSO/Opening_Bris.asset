  - stepName: StoryNum:1000002 | ID:11005 | BGM:Story1
    enableImageEffect: 1
    imageData:
      image: {fileID: 21300000, guid: d7341028d894e4b43b0885a3b0eb9079, type: 3}
      fadeDuration: 0
    enableDialogueEffect: 1
    dialogueData:
      dialogue: "\u201C\uB098\uB3C4 \uADF8 \uC18C\uC2DD \uB4E4\uC5C8\uB124. \uB098\uB3C4
        \uC9C0\uC6D0\uD560\uAE4C \uC0DD\uAC01\uD588\uC9C0\uB9CC.. \uB0B4 \uC790\uB9AC\uAC00
        \uC544\uB2C8\uB77C\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB124.\u201D"
      typewriterSpeed: 0.03
    enableSoundEffect: 0
    soundData:
      soundClip: {fileID: 0}
    enableBgmEffect: 1
    bgmData:
