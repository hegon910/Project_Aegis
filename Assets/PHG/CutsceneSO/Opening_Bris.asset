      fadeDuration: 0
    enableDialogueEffect: 1
    dialogueData:
      dialogue: "\u201C\uC9C0\uD718\uAD00\uB2D8. \uBB3C\uC790 \uC218\uC1A1\uC5D0\uC11C
        \uAE30\uBC1C\uD55C \uC544\uC774\uB514\uC5B4\uB97C \uB0B4\uC2E0 \uAC83\uB3C4,\n\uC800\uBA54\uB2C8\uC758
        \uC218\uC1A1\uAE30\uCC28 \uACF5\uACA9\uC744 \uBBF8\uB9AC \uC54C\uACE0 \uB300\uC751\uD558\uC2E0
        \uAC83.. \uC774\uB7F0 \uAC83 \uB9D0\uACE0\uB3C4 \uB9CE\uC774 \uC788\uC2B5\uB2C8\uB2E4.\u201D"
